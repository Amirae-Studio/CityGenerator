# Map setup — see "Map setup" in README.md.
# Mapbox public token (pk....), URL-restricted to your site and localhost.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: your Mapbox Studio street style built on Standard. Defaults to mapbox/standard.
NEXT_PUBLIC_MAPBOX_STREET_STYLE=
# Optional: your satellite style built on Standard Satellite. Defaults to mapbox/standard-satellite.
NEXT_PUBLIC_MAPBOX_SATELLITE_STYLE=
