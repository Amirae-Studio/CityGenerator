{
  "name": "city-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "lint": "eslint .",
    "preview:release": "node scripts/preview-release.mjs",
    "package": "vite build && rm -f dist.zip && cd dist && zip -qr -X ../dist.zip . -x \"*.DS_Store\""
  },
